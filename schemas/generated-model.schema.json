{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedboxes.local/schemas/generated-model.schema.json",
  "type": "object",
  "properties": {
    "generationId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engineFingerprint": {
      "type": "object"
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "mm"
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "panelId": {
            "enum": [
              "front",
              "back",
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "displayCode": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "thicknessMm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "nominalGeometry": {
            "type": "object",
            "properties": {
              "outer": {
                "type": "object",
                "properties": {
                  "pathId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commands": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 1
                    }
                  },
                  "closed": {
                    "type": "boolean"
                  },
                  "operation": {
                    "enum": [
                      "cut_outer",
                      "cut_inner",
                      "engrave",
                      "annotation"
                    ]
                  }
                },
                "required": [
                  "pathId",
                  "commands",
                  "closed",
                  "operation"
                ],
                "additionalProperties": false
              },
              "holes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pathId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commands": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "array",
                        "minItems": 1
                      }
                    },
                    "closed": {
                      "type": "boolean"
                    },
                    "operation": {
                      "enum": [
                        "cut_outer",
                        "cut_inner",
                        "engrave",
                        "annotation"
                      ]
                    }
                  },
                  "required": [
                    "pathId",
                    "commands",
                    "closed",
                    "operation"
                  ],
                  "additionalProperties": false
                }
              },
              "engravings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pathId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commands": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "array",
                        "minItems": 1
                      }
                    },
                    "closed": {
                      "type": "boolean"
                    },
                    "operation": {
                      "enum": [
                        "cut_outer",
                        "cut_inner",
                        "engrave",
                        "annotation"
                      ]
                    }
                  },
                  "required": [
                    "pathId",
                    "commands",
                    "closed",
                    "operation"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "outer",
              "holes",
              "engravings"
            ],
            "additionalProperties": false
          },
          "cutGeometry": {
            "type": "object",
            "properties": {
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pathId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commands": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "array",
                        "minItems": 1
                      }
                    },
                    "closed": {
                      "type": "boolean"
                    },
                    "operation": {
                      "enum": [
                        "cut_outer",
                        "cut_inner",
                        "engrave",
                        "annotation"
                      ]
                    }
                  },
                  "required": [
                    "pathId",
                    "commands",
                    "closed",
                    "operation"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "operations"
            ],
            "additionalProperties": false
          },
          "localFrame": {
            "type": "object"
          },
          "assemblyTransform": {
            "type": "object",
            "properties": {
              "matrixColumnMajor": {
                "type": "array",
                "minItems": 16,
                "maxItems": 16,
                "items": {
                  "type": "number"
                }
              },
              "conventionVersion": {
                "const": 1
              }
            },
            "required": [
              "matrixColumnMajor",
              "conventionVersion"
            ],
            "additionalProperties": false
          },
          "layoutTransform": {
            "type": [
              "object",
              "null"
            ]
          },
          "joints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "provenance": {
            "type": "object"
          }
        },
        "required": [
          "panelId",
          "displayCode",
          "label",
          "thicknessMm",
          "nominalGeometry",
          "cutGeometry",
          "localFrame",
          "assemblyTransform",
          "layoutTransform",
          "joints",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "geometries": {
      "type": "object",
      "properties": {
        "nominal": {
          "type": "boolean"
        },
        "compensatedToolpaths": {
          "type": "boolean"
        }
      },
      "required": [
        "nominal",
        "compensatedToolpaths"
      ],
      "additionalProperties": false
    },
    "innerDimensions": {
      "type": "object",
      "properties": {
        "widthMm": {
          "type": "number"
        },
        "depthMm": {
          "type": "number"
        },
        "heightMm": {
          "type": "number"
        }
      },
      "required": [
        "widthMm",
        "depthMm",
        "heightMm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "generationId",
    "projectId",
    "revision",
    "inputHash",
    "engineFingerprint",
    "adapterVersion",
    "units",
    "panels",
    "sheets",
    "diagnostics",
    "generatedAt",
    "geometries",
    "innerDimensions"
  ],
  "additionalProperties": false
}
